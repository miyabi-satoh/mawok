// mawok.amiiby.com に、紹介と規約類 (site/ をビルドしたもの) と、Mac 版の更新の確認先の JSON (site/public/updates/) を出す。
// 静的なファイルだけを出すので、Worker のコードは持たない。`pnpm run deploy` が先に site/ をビルドする。
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// 名前を変えると別の Worker になり、本番のホスト名を付け直すことになるので、窓口だった頃の名前のままにする。
	"name": "mawok-account",
	"compatibility_date": "2026-08-22",
	// 本番のホスト名。workers.dev には出さず、URL を1つにする。
	"routes": [{ "pattern": "mawok.amiiby.com", "custom_domain": true }],
	"workers_dev": false,
	"assets": {
		"directory": "../site/dist",
		"not_found_handling": "404-page",
		"html_handling": "force-trailing-slash"
	}
}
