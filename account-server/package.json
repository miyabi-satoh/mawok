{
	"name": "account-server",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "wrangler dev",
		"check": "tsc --noEmit",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"types": "wrangler types",
		"deploy": "pnpm --dir ../site run build && wrangler deploy"
	},
	"dependencies": {
		"hono": "^4.13.13"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.5",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.2"
	}
}
