{
	"name": "account-server",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"lint": "prettier --check .",
		"format": "prettier --write .",
