---
import '@fontsource/biz-udpgothic/400.css';
import '@fontsource/biz-udpgothic/700.css';
import '@fontsource-variable/m-plus-1/wght.css';
import '../styles/global.css';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description?: string;
  /** 検索結果に出さない (404 など) */
  noindex?: boolean;
  /** 本文の幅で包まず、画面の端まで使う (紹介)。サイトの頭と足の幅は、どのページも同じ */
  wide?: boolean;
}

const { title, description, noindex = false, wide = false } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />
    <meta property="og:site_name" content="Mawok" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <a class="site-name" href="/">
          <img class="site-icon" src="/icon.png" alt="" width="28" height="28" />
          Mawok
        </a>
        <nav class="site-nav" aria-label="サイト">
          <ul>
            <li><a href="/pricing/">料金</a></li>
            <!-- クレジットの確かめ・登録した PC の管理 (窓口。account-server/ が受ける) -->
            <li><a href="/account/">アカウント</a></li>
          </ul>
        </nav>
      </header>
    </div>
    {
      wide ? (
        <main class="wide">
          <slot />
        </main>
      ) : (
        <div class="page">
          <main class="reading">
            <slot />
          </main>
        </div>
      )
    }
    <div class="page">
      <footer class="site-footer">
        <ul>
          <li><a href="/terms/">利用規約</a></li>
          <li><a href="/privacy/">プライバシーポリシー</a></li>
          <li><a href="/tokushoho/">特定商取引法に基づく表記</a></li>
          <li>
            <!-- GitHub のマークは Primer Octicons の mark-github (MIT) -->
            <a class="footer-icon-link" href="https://github.com/miyabi-satoh/mawok"><svg class="footer-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"/></svg>GitHub</a>
          </li>
          <li><a href="https://amiiby.com/about/">運営者・問い合わせ</a></li>
        </ul>
        <p><a href="https://amiiby.com/">amiiby</a> © miyabi-satoh</p>
      </footer>
    </div>
    <Lightbox />
  </body>
</html>
