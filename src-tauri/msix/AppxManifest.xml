<?xml version="1.0" encoding="utf-8"?>
<!--
  Mawok の MSIX のマニフェスト (→ docs/platform.md「Windows の MSIX 版」)。
  `just msix` (scripts/msix.mjs) が {{NAME}}・{{PUBLISHER}}・{{PUBLISHER_DISPLAY_NAME}}・{{VERSION}} を埋め、
  exe とロゴを並べて makeappx に渡す。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <!-- Publisher は署名に使う証明書の Subject と一致させる。 -->
  <Identity Name="{{NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Mawok</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-JP" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Mawok" Executable="mawok.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Mawok"
        Description="Mawok"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- ログイン時の起動。登録するかはアプリが設定に合わせて決める (StartupTask の RequestEnableAsync) ので、既定では無効にしておく。 -->
        <desktop:Extension Category="windows.startupTask" Executable="mawok.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="Mawok" Enabled="false" DisplayName="Mawok" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
